terraform {
  required_version = ">= 1.5"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

variable "aws_region" {
  type    = string
  default = "ap-south-1"
}

variable "project_name" {
  type    = string
  default = "agriculturegpt"
}

# Deployment scaffold: create ECS, ALB, ECR and secrets before production use.
# External account credentials and MongoDB/Chroma operations require explicit setup.

